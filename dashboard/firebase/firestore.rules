rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function rawRole() {
      return userDoc().data.role;
    }

    /** Normalized role aligned with mobile (owner → admin, etc.) */
    function userRole() {
      let role = rawRole();
      return role == 'owner' ? 'admin'
        : role == 'user' ? 'elaboro'
        : role == 'customer' ? 'elaboro'
        : role == 'advisor' ? 'supervisor'
        : role;
    }

    function isAdmin() {
      return signedIn() && userRole() == 'admin';
    }

    function isSupervisor() {
      return signedIn() && userRole() == 'supervisor';
    }

    function isMeli() {
      return signedIn() && userRole() == 'meli';
    }

    function isOperador() {
      return signedIn() && userRole() == 'operador';
    }

    function isCliente() {
      return signedIn() && userRole() == 'cliente';
    }

    function isElaboro() {
      return signedIn() && userRole() == 'elaboro';
    }

    function canCreateSheets() {
      // MD §13 — any signed-in user; createdBy checked on the match rule.
      return signedIn();
    }

    function sheetCreateStatusOk() {
      let status = request.resource.data.get('status', 'draft');
      return status in [
        'draft',
        'pending_supervisor',
        'pending_meli',
        'pending_logistics',
        'pending_process2',
        'pending_cliente',
        'completed',
        'rejected',
        'canceled'
      ];
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ['elaboro', 'supervisor', 'meli', 'operador', 'cliente'];
      allow update: if signedIn() && (
        (request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'assignedSiteIds', 'assignedLogisticsIds']))
        // Logistics users may self-assign logistics accounts (not role/sites).
        || (request.auth.uid == userId
          && isOperador()
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'assignedSiteIds']))
        || isAdmin()
      );
      allow delete: if isAdmin();

      match /serviceSheets/{sheetId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /serviceSheets/{sheetId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && sheetCreateStatusOk();

      allow update: if signedIn() && (
        isAdmin()
        || (
          resource.data.createdBy == request.auth.uid
          && resource.data.get('status', 'draft') in ['draft', 'rejected']
        )
        || isSupervisor()
        || isMeli()
        || isOperador()
        || isCliente()
        || (
          isElaboro()
          && resource.data.createdBy == request.auth.uid
        )
      );

      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.createdBy == request.auth.uid
          && resource.data.get('status', 'draft') == 'draft'
        );
    }

    match /roleChangeRequests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedRole in ['elaboro', 'supervisor', 'meli', 'operador', 'cliente'];
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'pending'
        );
    }

    match /siteChangeRequests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedSiteIds is list;
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'pending'
        );
    }

    match /sites/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /materials/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /measureUnits/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /transportUnits/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
